# Copy to .env for running locally. On Posit, set these as environment variables instead.
# Never commit the completed .env file.
CLIENT_ID=replace-with-your-client-id
CLIENT_SECRET=replace-with-your-client-secret
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# The app's URL, without a trailing slash. Register <APP_URL>/redirect with the OAuth client.
APP_URL=http://127.0.0.1:8050
DASH_DEBUG=false

# Registration API: v2 is the default. To fall back to the unversioned v1 API, uncomment:
# REGISTRATION_API_BASE=https://apps.csipacific.ca/api/registration/
