# Copy this file to .env and replace the placeholder values.
# Never commit the completed .env file.
CLIENT_ID=replace-with-your-client-id
CLIENT_SECRET=replace-with-your-new-client-secret
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Local settings
APP_URL=http://127.0.0.1:8050
DASH_DEBUG=false

# Registration API: v2 is the default. To fall back to the unversioned v1 API
# during the changeover, uncomment the next line.
# REGISTRATION_API_BASE=https://apps.csipacific.ca/api/registration/

# Conversion Update tab: where "Load latest from GitHub" reads, and "Push to GitHub" commits,
# the conversion dataset. Reading needs no token (public repo). Pushing needs GITHUB_TOKEN:
# a fine-grained personal access token limited to this one repo with
# Repository permissions -> Contents: Read and write. Keep it only in .env (never commit it).
# CONVERSION_GITHUB_REPO=LukeSpagnuolo/Conversion
# CONVERSION_GITHUB_BRANCH=main
# CONVERSION_GITHUB_PATH=Conversion_Data_2026_final.csv
# GITHUB_TOKEN=
